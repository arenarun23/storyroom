# Supabase 프로젝트 설정 (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role 키 — 서버 코드에서만 사용, 클라이언트 번들 절대 포함 금지 (비공개)
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3 키 (비공개)
YOUTUBE_API_KEY=

# AI 코멘트 생성용 API 키 (비공개)
AI_API_KEY=

# Vercel Blob — 등급 아이콘 업로드용 (비공개)
BLOB_READ_WRITE_TOKEN=

# Vercel Cron 엔드포인트 인증 헤더 값 (비공개)
CRON_SECRET=
